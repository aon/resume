---
import Envelope from "@phosphor-icons/core/regular/envelope.svg";
import LinkedinLogo from "@phosphor-icons/core/regular/linkedin-logo.svg";
import Phone from "@phosphor-icons/core/regular/phone.svg";
import MapPin from "@phosphor-icons/core/regular/map-pin.svg";
import type { Contact } from "../data/types";

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;
---

<header>
  <h1 class="m-0 text-[32pt] leading-none font-medium">{contact.name}</h1>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-[9pt] leading-[1.3]">
    <a class="inline-flex items-center gap-1 whitespace-nowrap" href={`mailto:${contact.email}`}>
      <Envelope class="block size-[14px] shrink-0" aria-hidden="true" focusable="false" /><span class="leading-none">{contact.email}</span>
    </a>
    <a class="inline-flex items-center gap-1 whitespace-nowrap" href={contact.linkedin.url}>
      <LinkedinLogo class="block size-[14px] shrink-0" aria-hidden="true" focusable="false" /><span class="leading-none">{contact.linkedin.label}</span>
    </a>
    <a class="inline-flex items-center gap-1 whitespace-nowrap" href={`tel:${contact.phone.tel}`}>
      <Phone class="block size-[14px] shrink-0" aria-hidden="true" focusable="false" /><span class="leading-none">{contact.phone.label}</span>
    </a>
    <span class="inline-flex items-center gap-1 whitespace-nowrap">
      <MapPin class="block size-[14px] shrink-0" aria-hidden="true" focusable="false" /><span class="leading-none">{contact.location}</span>
    </span>
  </div>
</header>
